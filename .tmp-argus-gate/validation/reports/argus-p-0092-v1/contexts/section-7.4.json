    "problems": [
      {
        "coverage_id": "SDD-L0939",
        "semantic_kind": "課題",
        "source_locator": "SDD line 939",
        "original_text": "変更階層、承認対象、Rollback境界が曖昧だと、Objectiveの自己正当化や事実履歴の巻戻しが起き得る。"
      },
      {
        "coverage_id": "SDD-L1435",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1435",
        "original_text": "変更後に成立済みCapabilityを再確認しないと、局所修正がState・Funds・Approval等の不変条件を破り得る。"
      },
      {
        "coverage_id": "SDD-L1593",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1593",
        "original_text": "現行Baselineと過去の変更履歴を混同すると、旧要件を現行仕様として再導入し得る。"
      }
    ],
    "purposes": [
      {
        "coverage_id": "SDD-L0941",
        "semantic_kind": "目的",
        "source_locator": "SDD line 941",
        "original_text": "Breakを影響範囲別に分類し、具体的diff・再承認・Version切替へ拘束する。"
      },
      {
        "coverage_id": "SDD-L1437",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1437",
        "original_text": "変更影響に応じたAffected / Core / Full回帰集合で不変条件を検証する。"
      },
      {
        "coverage_id": "SDD-L1595",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1595",
        "original_text": "現行仕様に必要なVersion管理規則だけを保持する。"
      }
    ],
    "design_reasons": [],
    "processes": [
      {
        "coverage_id": "SDD-L0943",
        "semantic_kind": "対象",
        "source_locator": "SDD line 943",
        "original_text": "B1〜B4、Break Proposal、Human Approval、Rollback、System Version。"
      },
