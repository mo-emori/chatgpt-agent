{
  "context": {
    "section_id": "2.6",
    "title": "ポートフォリオ管理",
    "depth": 2,
    "premises": [
      {
        "coverage_id": "SDD-L0741",
        "semantic_kind": "前提",
        "source_locator": "SDD line 741",
        "original_text": "`target`、`min / max`、Policy Modeは、Allocationと決定論的Validatorで異なる強制レベルを持つ。"
      }
    ],
    "problems": [
      {
        "coverage_id": "SDD-L0678",
        "semantic_kind": "課題",
        "source_locator": "SDD line 678",
        "original_text": "魅力度だけではPortfolio制約、Cash、役割配分、Thesis崩壊を扱えない。"
      },
      {
        "coverage_id": "SDD-L0686",
        "semantic_kind": "課題",
        "source_locator": "SDD line 686",
        "original_text": "RoleとHorizonを一つの比率軸へ混在させると、lotの二重計上が起き得る。"
      },
      {
        "coverage_id": "SDD-L0699",
        "semantic_kind": "課題",
        "source_locator": "SDD line 699",
        "original_text": "未設定Policyを0または無制限として扱うと、未承認Tradeが有効になり得る。"
      },
      {
        "coverage_id": "SDD-L0712",
        "semantic_kind": "課題",
        "source_locator": "SDD line 712",
        "original_text": "初期構築や違反回復を通常制約の場当たり的免除として扱うと、違反を恒久化し得る。"
      },
      {
        "coverage_id": "SDD-L0726",
        "semantic_kind": "課題",
        "source_locator": "SDD line 726",
        "original_text": "売却判断を価格変化だけへ縮約すると、Thesis崩壊、Portfolio Risk、Opportunity Costを見落とす。"
      },
      {
        "coverage_id": "SDD-L0743",
        "semantic_kind": "課題",
        "source_locator": "SDD line 743",
        "original_text": "targetとmin / max、通常運用と構築・回復を同じ強制条件として扱うと、AllocationまたはRecoveryが成立しない。"
      },
      {
        "coverage_id": "SDD-L1823",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1823",
        "original_text": "将来目安例を確定Policyと誤認すると、未承認比率を本番制約へ固定し得る。"
      }
    ],
    "purposes": [
      {
        "coverage_id": "SDD-L0680",
        "semantic_kind": "目的",
        "source_locator": "SDD line 680",
        "original_text": "Allocationと売却判断を明示Policyと決定論的制約へ接続する。"
      },
      {
        "coverage_id": "SDD-L0688",
        "semantic_kind": "目的",
        "source_locator": "SDD line 688",
        "original_text": "Portfolioの役割分類と想定時間軸を独立した軸として示す。"
      },
      {
        "coverage_id": "SDD-L0701",
        "semantic_kind": "目的",
        "source_locator": "SDD line 701",
        "original_text": "Policyの有効化と欠落時のFail Closed遷移を定義する。"
      },
      {
        "coverage_id": "SDD-L0714",
        "semantic_kind": "目的",
        "source_locator": "SDD line 714",
        "original_text": "一時的な構築・回復を明示条件と終了条件へ拘束する。"
      },
      {
        "coverage_id": "SDD-L0728",
        "semantic_kind": "目的",
        "source_locator": "SDD line 728",
        "original_text": "売却・再分析の判定入力と次処理を種類別に分離する。"
      },
      {
        "coverage_id": "SDD-L0745",
        "semantic_kind": "目的",
        "source_locator": "SDD line 745",
        "original_text": "Soft target、Hard制約、BOOTSTRAP / REPAIR進捗条件を分離する。"
      },
      {
        "coverage_id": "SDD-L1825",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1825",
        "original_text": "高配当Core方針、評価観点、例示値、確定性を分離する。"
      }
    ],
    "design_reasons": [],
    "processes": [
