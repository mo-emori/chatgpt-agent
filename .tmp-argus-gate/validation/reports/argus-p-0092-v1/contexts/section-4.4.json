    "title": "外部障害",
    "depth": 2,
    "premises": [],
    "problems": [
      {
        "coverage_id": "SDD-L1243",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1243",
        "original_text": "Local停止、Provider障害、Storage不在、破損、入力矛盾は通常運用中に発生し、誤った継続や事実推測につながり得る。"
      },
      {
        "coverage_id": "SDD-L1251",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1251",
        "original_text": "異なる失敗を一律Retryまたは一律停止すると、無限Retry、危険継続、復旧不能が起き得る。"
      }
    ],
    "purposes": [
      {
        "coverage_id": "SDD-L1245",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1245",
        "original_text": "失敗分類から安全な停止・Retry・Reconciliationへ追跡可能にする。"
      },
      {
        "coverage_id": "SDD-L1253",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1253",
        "original_text": "失敗条件から状態、即時処理、復旧条件、人の関与までを追跡可能にする。"
      }
    ],
    "design_reasons": [],
    "processes": [
      {
        "coverage_id": "SDD-L1247",
        "semantic_kind": "対象",
        "source_locator": "SDD line 1247",
        "original_text": "Runtime、Adapter、State、Storage、Budget、Secret、Clock。"
      },
      {
        "coverage_id": "SDD-L1255",
        "semantic_kind": "対象",
        "source_locator": "SDD line 1255",
        "original_text": "Network、Provider、Budget、Identity、State、Storage、Backup、Execution、Secret、Clockの失敗。"
