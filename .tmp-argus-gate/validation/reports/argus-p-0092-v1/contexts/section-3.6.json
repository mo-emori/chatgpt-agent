    "problems": [
      {
        "coverage_id": "SDD-L1169",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1169",
        "original_text": "Job途中でConfigurationが変わると、同一Runの判断条件と費用上限を再現できない。"
      },
      {
        "coverage_id": "SDD-L1529",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1529",
        "original_text": "分析機能を安全基盤より先に実装したり、DeploymentでState / Config / Dataを上書きしたりすると、検証不能なRuntimeが成立し得る。"
      },
      {
        "coverage_id": "SDD-L1571",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1571",
        "original_text": "稼働中更新や部分置換は、State破損、Schema不整合、復旧不能を引き起こし得る。"
      }
    ],
    "purposes": [
      {
        "coverage_id": "SDD-L1171",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1171",
        "original_text": "Job開始時snapshotと変更適用境界を固定する。"
      },
      {
        "coverage_id": "SDD-L1531",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1531",
        "original_text": "Authority・Cost・State integrity・Recoveryを先行させ、停止・Backup・Schema確認を伴う配備順を固定する。"
      },
      {
        "coverage_id": "SDD-L1573",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1573",
        "original_text": "Runtime停止、Backup、Code置換、Schema確認を順序化して安全に配備する。"
      }
    ],
    "design_reasons": [],
    "processes": [
      {
        "coverage_id": "SDD-L1173",
        "semantic_kind": "対象",
        "source_locator": "SDD line 1173",
        "original_text": "Config version/hash、運用中変更、Budget limit低下。"
      },
