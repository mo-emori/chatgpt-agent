    "title": "HumanとARGUSの役割分担",
    "depth": 2,
    "premises": [],
    "problems": [
      {
        "coverage_id": "SDD-L0043",
        "semantic_kind": "課題",
        "source_locator": "SDD line 43",
        "original_text": "人、ARGUS、Broker、Agentの権限をRuntime componentや処理機能と混同すると、Human-in-the-loopと更新境界が崩れる。"
      },
      {
        "coverage_id": "SDD-L0262",
        "semantic_kind": "課題",
        "source_locator": "SDD line 262",
        "original_text": "提案・判断・状態更新・外部実行のAuthorityが曖昧になると、自動売買やWriter迂回が成立し得る。"
      }
    ],
    "purposes": [
      {
        "coverage_id": "SDD-L0045",
        "semantic_kind": "目的",
        "source_locator": "SDD line 45",
        "original_text": "設計上の権限主体を、その意味と実行主体・処理責務との関係によって区別する。"
      },
      {
        "coverage_id": "SDD-L0264",
        "semantic_kind": "目的",
        "source_locator": "SDD line 264",
        "original_text": "権限主体の許可操作と、Runtime / UI componentである実行主体の処理責務を分離し、Human-in-the-loopとSingle Writer境界を維持する。"
      }
    ],
    "design_reasons": [],
    "processes": [
      {
        "coverage_id": "SDD-L0047",
        "semantic_kind": "対象",
        "source_locator": "SDD line 47",
        "original_text": "人、ARGUS、Broker、Agent / LLM。"
      },
      {
