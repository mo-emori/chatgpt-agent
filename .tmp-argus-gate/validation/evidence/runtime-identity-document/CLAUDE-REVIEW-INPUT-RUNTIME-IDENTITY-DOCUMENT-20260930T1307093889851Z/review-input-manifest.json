  "critical_path_invariants": [
    {
      "invariant": "Runtime Identity contains only the exact five-field logical instance identity and excludes deployment identity, run identity, paths, mutable configuration, secrets, status, domain state, runtime state, provider plan tier, and code/install paths.",
      "source": "Runtime Identity Contract §2-3"
    },
    {
      "invariant": "Parsing is strict bytes-to-domain validation with no coercion, inference, defaulting, repair, trimming, case conversion, timezone repair, UUID generation, or unknown-field removal.",
      "source": "Runtime Identity Contract §4"
    },
    {
      "invariant": "Validation phases, terminal failures, complete error collection, field semantics, and error ordering are deterministic and follow the contract-defined precedence.",
      "source": "Runtime Identity Contract §4.3-5"
    },
    {
      "invariant": "Parsing and serialization are pure, mutually bounded operations; parse/schema/domain failures remain typed values, while serializer misuse remains TypeError or ValueError.",
      "source": "Runtime Identity Contract §5-6"
    },
    {
      "invariant": "Serialization produces the exact canonical UTF-8 bytes and repeated parse/serialize operations are deterministic.",
      "source": "Runtime Identity Contract §7 and §9 RI-L0-023..027"
    },
    {
      "invariant": "The dependency direction remains environment.py -> runtime_identity.py; Runtime Identity does not depend on Marker, Binding, Store, or Guard and does not derive expected identity from Data Root values.",
      "source": "Runtime Identity Contract §8"
    }
  ],
