    "problems": [
      {
        "coverage_id": "SDD-L0994",
        "semantic_kind": "課題",
        "source_locator": "SDD line 994",
        "original_text": "個別部品の成功だけでは、BUYから全売却、再起動復元までの閉ループ成立を証明できない。"
      },
      {
        "coverage_id": "SDD-L1466",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1466",
        "original_text": "未来情報、架空約定、短期間の結果を実資金性能の証明と誤認すると、未検証のRiskをLiveへ持ち込む。"
      },
      {
        "coverage_id": "SDD-L1474",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1474",
        "original_text": "後日改訂値、現在Universe、未来価格を過去時点へ混入すると、Historical評価が過大になる。"
      },
      {
        "coverage_id": "SDD-L1509",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1509",
        "original_text": "前段階の能力・契約・検証限界を満たさず次段階へ進むと、未成立条件をPaperまたはLiveへ持ち込む。"
      }
    ],
    "purposes": [
      {
        "coverage_id": "SDD-L0996",
        "semantic_kind": "目的",
        "source_locator": "SDD line 996",
        "original_text": "最小の投資枝でState、Human Approval、Fact、Watch、復旧を端から端まで検証する。"
      },
      {
        "coverage_id": "SDD-L1468",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1468",
        "original_text": "検証種別ごとの能力限界と、次段階へ進むGateを固定する。"
      },
      {
        "coverage_id": "SDD-L1476",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1476",
        "original_text": "Simulation時点で利用可能だったDataだけを供給する条件を定義する。"
      },
      {
        "coverage_id": "SDD-L1511",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1511",
        "original_text": "各段階の前提、完了条件、次段階、決定権限を固定する。"
      }
    ],
