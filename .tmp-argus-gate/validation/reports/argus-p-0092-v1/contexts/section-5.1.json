    "title": "CLI / Human Interface",
    "depth": 2,
    "premises": [],
    "problems": [
      {
        "coverage_id": "SDD-L1183",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1183",
        "original_text": "CLI、Tray、Runnerが独自LogicやWriter経路を持つと、同じ操作で異なる検証・更新結果が生じ得る。"
      },
      {
        "coverage_id": "SDD-L1191",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1191",
        "original_text": "Human操作の入口とWriter / Serviceが不明確だと、検証経路の分岐や直接更新が起き得る。"
      },
      {
        "coverage_id": "SDD-L1221",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1221",
        "original_text": "相対的なBUSY指定と適用時刻を区別しないと、週境界やRunner停止後の状態遷移を誤り得る。"
      }
    ],
    "purposes": [
      {
        "coverage_id": "SDD-L1185",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1185",
        "original_text": "Human操作を共有Command / Service Layerへ統一し、非RUNNING時にもStatus、Help、System Statusの安全な操作入口を保つ。"
      },
      {
        "coverage_id": "SDD-L1193",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1193",
        "original_text": "各Commandの入力、処理、出力、更新主体、失敗動作を固定する。"
      },
      {
        "coverage_id": "SDD-L1223",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1223",
        "original_text": "presetを絶対終了時刻へ解決し、契約時刻と実適用時刻を追跡する。"
      }
    ],
    "design_reasons": [],
    "processes": [
      {
        "coverage_id": "SDD-L1187",
        "semantic_kind": "対象",
        "source_locator": "SDD line 1187",
        "original_text": "Status、Budget、Proposal、Approval、Execution Paste、Alert、System操作。"
      },
