    "problems": [
      {
        "coverage_id": "SDD-L0769",
        "semantic_kind": "課題",
        "source_locator": "SDD line 769",
        "original_text": "保有・候補・市場を同じ周期で扱うこと、およびLocal停止中も監視できると誤認することは、重大Riskの見逃しや能力の過大表示につながる。"
      },
      {
        "coverage_id": "SDD-L1343",
        "semantic_kind": "課題",
        "source_locator": "SDD line 1343",
        "original_text": "Event取得、Thesis差分、再分析、通知を一段階として扱うと、Data不足やLatency境界を隠し得る。"
      }
    ],
    "purposes": [
      {
        "coverage_id": "SDD-L0771",
        "semantic_kind": "目的",
        "source_locator": "SDD line 771",
        "original_text": "監視対象別の優先度と、取得から通知までの観測可能なLatency境界を明示する。"
      },
      {
        "coverage_id": "SDD-L1345",
        "semantic_kind": "目的",
        "source_locator": "SDD line 1345",
        "original_text": "EventからHuman判断候補までの処理順序と各段階の失敗動作を分離する。"
      }
    ],
    "design_reasons": [],
